@model IEnumerable<GymManagementSystem.BLL.ViewModels.Memberships.MembershipViewModel>

@{
    ViewData["Title"] = "Memberships";
}

<div class="container my-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bolder text-primary-color mb-1">Memberships</h2>
            <p class="text-black-alternative mb-0">Manage gym member plans and active subscriptions</p>
        </div>
        <a asp-action="Create" class="btn bg-primary-color text-white rounded-pill px-4 py-2 fw-medium">
            + Assign Plan
        </a>
    </div>

    <!-- Table Section -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 px-4 text-uppercase fs-14 text-muted fw-bold">Member</th>
                            <th class="py-3 px-4 text-uppercase fs-14 text-muted fw-bold">Plan</th>
                            <th class="py-3 px-4 text-uppercase fs-14 text-muted fw-bold">Start Date</th>
                            <th class="py-3 px-4 text-uppercase fs-14 text-muted fw-bold">End Date</th>
                            <th class="py-3 px-4 text-uppercase fs-14 text-muted fw-bold">Status</th>
                            <th class="py-3 px-4 text-uppercase fs-14 text-muted fw-bold text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="px-4 fw-bold text-black-alternative">@item.MemberName</td>
                                    <td class="px-4">
                                        <span class="badge bg-primary-color px-3 py-2 rounded-pill fs-14">
                                            @item.PlanName
                                        </span>
                                    </td>
                                    <td class="px-4">@item.StartDate.ToString("yyyy-MM-dd")</td>
                                    <td class="px-4">@item.EndDate.ToString("yyyy-MM-dd")</td>
                                    <td class="px-4">
                                        @if (item.EndDate > DateTime.Now)
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success px-3 py-2 rounded-pill fw-medium">
                                                Active
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-2 rounded-pill fw-medium">
                                                Expired
                                            </span>
                                        }
                                    </td>
                                    <td class="px-4 text-center">
                                        @if (item.EndDate > DateTime.Now)
                                        {
                                            <form asp-action="Cancel" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to cancel this membership?');">
                                                <input type="hidden" name="memberId" value="@item.MemberId" />
                                                <input type="hidden" name="planId" value="@item.PlanId" />
                                                <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3">
                                                    Cancel
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted fs-14">-</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    No memberships found. Click "+ Assign Plan" to create one.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>