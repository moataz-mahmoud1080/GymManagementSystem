@using GymManagementSystem.BLL.ViewModels.Sessions_Schedule
@model BookingCreateViewModel

@{
    ViewData["Title"] = "Book Session";
}

<div class="container my-5" style="max-width: 600px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">
        <h3 class="fw-bolder text-primary-color mb-4 text-center">Book Session for Member</h3>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="MemberId" class="form-label fw-bold text-black-alternative">Select Member</label>
                <select asp-for="MemberId" asp-items="Model.Members" class="form-select rounded-3 py-2">
                    <option value="">-- Choose Member --</option>
                </select>
                <span asp-validation-for="MemberId" class="text-danger fs-14"></span>
            </div>

            <div class="mb-4">
                <label asp-for="SessionId" class="form-label fw-bold text-black-alternative">Select Session</label>
                <select asp-for="SessionId" asp-items="Model.Sessions" class="form-select rounded-3 py-2">
                    <option value="">-- Choose Upcoming Session --</option>
                </select>
                <span asp-validation-for="SessionId" class="text-danger fs-14"></span>
            </div>

            <div class="d-flex gap-3 mt-4">
                <button type="submit" class="btn bg-primary-color text-white rounded-pill py-2 flex-grow-1 fw-bold">
                    Confirm Booking
                </button>
                <a asp-action="Index" class="btn border-secondary text-secondary rounded-pill py-2 px-4">
                    Back
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}