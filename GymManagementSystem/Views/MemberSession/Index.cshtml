@using GymManagementSystem.BLL.ViewModels.Sessions_Schedule
@model IEnumerable<SessionScheduleViewModel>

@{
    ViewData["Title"] = "Sessions Schedule";
}

<div class="container my-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bolder text-primary-color mb-1">Sessions Schedule</h2>
            <p class="text-black-alternative mb-0">Browse upcoming sessions and book attendance for members</p>
        </div>
        <a asp-action="Create" class="btn bg-primary-color text-white rounded-pill px-4 py-2 fw-medium">
            + Book Session
        </a>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @if (Model != null && Model.Any())
        {
            foreach (var item in Model)
            {
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
                        <div class="card-header bg-light border-0 d-flex justify-content-between align-items-center pt-3 px-4">
                            <span class="badge bg-primary-color px-3 py-2 rounded-pill fs-14">
                                @item.CategoryName
                            </span>
                            @if (item.Status == "Upcoming")
                            {
                                <span class="badge bg-info bg-opacity-10 text-info rounded-pill px-3 py-1">Upcoming</span>
                            }
                            else if (item.Status == "Ongoing")
                            {
                                <span class="badge bg-success bg-opacity-10 text-success rounded-pill px-3 py-1">Ongoing</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary rounded-pill px-3 py-1">Completed</span>
                            }
                        </div>

                        <div class="card-body px-4 py-3">
                            <h5 class="fw-bold text-black-alternative mb-2">Trainer: @item.TrainerName</h5>
                            <p class="text-muted fs-14 mb-3">
                                <i class="bi bi-clock me-1"></i>
                                @item.StartDate.ToString("ddd, dd MMM - hh:mm tt")
                            </p>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top">
                                <div class="capacity-info">
                                    <small class="text-muted d-block">Capacity</small>
                                    <span class="fw-bold fs-5 @(item.IsFull ? "text-danger" : "text-black-alternative")">
                                        @item.BookedCount / @item.Capacity
                                    </span>
                                </div>
                                <div>
                                    @if (item.IsFull)
                                    {
                                        <span class="badge bg-danger rounded-pill px-3 py-2">Full Capacity</span>
                                    }
                                    else if (item.Status == "Upcoming")
                                    {
                                        <a asp-action="Create" asp-route-sessionId="@item.SessionId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                            Book Member
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="card border-0 shadow-sm rounded-4 text-center py-5">
                    <p class="text-muted mb-0">No sessions available in the schedule.</p>
                </div>
            </div>
        }
    </div>
</div>